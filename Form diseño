import { useState } from "react";

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
const MENSAJE_MIN = 10;
const MENSAJE_MAX = 500;

function validar(campo, valor) {
  const texto = valor.trim();

  if (campo === "nombre") {
    if (texto === "") return "Escribe tu nombre.";
    if (texto.length < 2) return "El nombre debe tener al menos 2 letras.";
  }

  if (campo === "email") {
    if (texto === "") return "Escribe tu correo electrónico.";
    if (!EMAIL_RE.test(texto)) return "Escribe un correo válido, por ejemplo: nombre@correo.com.";
  }

  if (campo === "mensaje") {
    if (texto === "") return "Cuéntame sobre tu proyecto.";
    if (texto.length < MENSAJE_MIN)
      return `El mensaje debe tener al menos ${MENSAJE_MIN} caracteres.`;
    if (valor.length > MENSAJE_MAX) return `El mensaje no puede pasar de ${MENSAJE_MAX} caracteres.`;
  }

  return "";
}

function Campo({ id, etiqueta, error, children }) {
  return (
    <div>
      <label htmlFor={id} className="block text-sm font-medium text-zinc-800">
        {etiqueta}
      </label>
      <div className="mt-1">{children}</div>
      <p id={`${id}-error`} role="alert" className="min-h-5 mt-1 text-sm text-red-700">
        {error}
      </p>
    </div>
  );
}

const claseEntrada = (hayError) =>
  `w-full px-3 py-2 rounded-lg border text-zinc-900 bg-white placeholder-zinc-400 focus:outline-none focus:ring-4 ${
    hayError
      ? "border-red-500 focus:ring-red-200"
      : "border-zinc-300 focus:border-fuchsia-600 focus:ring-fuchsia-200"
  }`;

